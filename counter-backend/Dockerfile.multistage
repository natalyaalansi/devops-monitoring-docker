FROM python:3.11.6-slim-bookworm AS base


FROM base AS build
SHELL [ "/bin/sh", "-eu", "-c" ]

WORKDIR /build

COPY pyproject.toml poetry.lock README.md ./

RUN python -m pip install \
    --no-color \
    --no-cache-dir \
    --disable-pip-version-check \
    poetry poetry-plugin-export setuptools wheel

COPY src/ src/

RUN mkdir -p dist \
    && poetry export \
        --without-hashes \
        --format constraints.txt \
        --output dist/constraints.txt \
    && poetry run python -m pip wheel \
        --isolated \
        --requirement dist/constraints.txt \
        --wheel-dir dist/vendor

RUN poetry build --format wheel


FROM base AS final
SHELL [ "/bin/sh", "-eu", "-c" ]

WORKDIR /app

COPY --from=build /build/dist/ dist/

RUN packages=$(find dist dist/vendor \
        -maxdepth 1 \
        -iname '*.whl' \
        -exec realpath {} \; \
        -print0 | xargs -0) \
    && python -m pip install \
        --isolated \
        --no-index \
        --no-color \
        --no-cache-dir \
        --disable-pip-version-check \
        --no-deps \
        ${packages}

ENV PORT="8080"
ENV HOST="0.0.0.0"

EXPOSE ${PORT}/tcp

ENTRYPOINT [ "python", "-m", "counter_backend" ]