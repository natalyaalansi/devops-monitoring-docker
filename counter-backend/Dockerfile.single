FROM python:3.11.6-slim-bookworm

SHELL [ "/bin/sh", "-eu", "-c" ]

WORKDIR /build

COPY src/ src/
COPY pyproject.toml poetry.lock README.md ./

RUN pip install --no-cache-dir poetry
RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi

ENV PORT="8080"
ENV HOST="0.0.0.0"

EXPOSE ${PORT}/tcp

ENTRYPOINT [ "server" ]